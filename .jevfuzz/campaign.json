{
  "version": 2,
  "name": "synthetic-action-smoke",
  "provider": "cloudflare",
  "seeds": [{
    "id": "synthetic-invoice-ticket",
    "request": {
      "state": {"message": "Synthetic request: I need an invoice for my subscription.", "locale": "en", "channel": "web"},
      "model": "jev-latest",
      "questions": {
        "department": {"type": "choice", "instructions": "Select the responsible department.", "criteria": {"billing": "Billing or invoices", "general": "Other questions"}}
      }
    }
  }],
  "contracts": [{
    "id": "department-stable",
    "question": "department",
    "relation": "invariant",
    "projection": "choice",
    "mutations": ["question_id_rename", "object_key_order", "choice_criteria_order"],
    "admissibility": "declared",
    "assumptions": ["JSON object key order, question identifiers and Choice presentation order do not change the responsible department."]
  }],
  "search": {"strategy": "uniform", "seed": 42, "maxDepth": 2, "maxCandidates": 8, "concurrency": 2},
  "oracle": {"profile": "paired-v1", "pairs": 8},
  "budget": {"logicalRequests": 112, "httpAttempts": 560, "wallTimeSeconds": 300, "discoveryRequests": 16, "confirmationRequests": 96, "shrinkRequests": 0, "finalConfirmationRequests": 0},
  "storage": {"mode": "hash-only", "directory": "runs", "maxRunBytes": 33554432}
}
